{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git branch -D*": "ask",
      "git clean -f*": "ask",
      "rm -rf*": "ask",
      "sudo *": "ask",
      "* | sh*": "ask",
      "* | bash*": "ask"
    }
  }
}