# =============================================================================
# .gitignore — Files not to commit to git
# =============================================================================

# ── Sensitive files ──────────────────────────────────────────────────────────
# Machine-specific overrides (e.g. ~/.zshrc.local, sourced by zsh/.zshrc)
*.local
*.secret
.env*
# Live secrets file — normally lives at ~/.config/zsh/env.local (outside this
# repo), ignored here so an accidental copy inside the tree can never be staged.
env.local

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editor files ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
